# Copie para .env e preencha — ou preencha pela aba Configurações → Conexões do painel (testa e grava aqui).
# NUNCA versionar o .env nem copiar valores para o cofre Obsidian.

# Pluggy (Open Finance, somente leitura) — dashboard.pluggy.ai → Applications
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# ids dos items conectados no Meu Pluggy (Inter, XP), separados por vírgula
PLUGGY_ITEM_IDS=

# Binance — chave com SOMENTE "Enable Reading" (sem trade/saque), idealmente com IP restrito
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Exportação para o cofre (só escreve com `python -m financas.cli export --write`)
# Caminho completo da nota do cofre que recebe o resumo (deixe vazio para não exportar)
OBSIDIAN_NOTE=

# Opcional: outra pasta de dados (ex.: data/demo para os dados fictícios)
# FIN_DATA_DIR=

# Opcional: pasta de contas de consumo (padrão: <pasta de dados>/contas). Pode ser uma pasta sincronizada
# (OneDrive, Dropbox, pasta de rede). O app cria entrada/, importadas/ e revisar/ sozinho.
# Coloque o PDF da fatura em entrada/ e ele é lançado no próximo `sync` (ou `python -m financas.cli contas`).
# FIN_BILLS_DIR=

# Opcional: outro arquivo de chaves (ex.: no Docker, um arquivo dentro do volume de dados, para a tela poder gravar)
# FIN_ENV_FILE=
