# Copie para .env e preencha. NUNCA versionar o .env nem copiar valores para o cofre Obsidian.

# Pluggy (Open Finance, somente leitura) — dashboard.pluggy.ai → Applications
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# ids dos items conectados no Meu Pluggy (Inter, XP), separados por vírgula
PLUGGY_ITEM_IDS=

# Binance — chave com SOMENTE "Enable Reading" (sem trade/saque), idealmente com IP restrito
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Exportação para o cofre (só escreve com `python -m financas.cli export --write`)
OBSIDIAN_NOTE="/Users/gabrielalvarenga/Library/CloudStorage/OneDrive-Pessoal/Obsidian/Obsidian Pessoal - Meu cofre/Projeto Financeiro/01 - Visão Geral/Painel Financeiro (automático).md"

# Opcional: outra pasta de dados (ex.: data/demo para os dados fictícios)
# FIN_DATA_DIR=
